table _Measures
	lineageTag: 0e1d43dc-71b5-4436-b77b-d3f8687faec8

	measure 'Net Revenue' = SUM ( 'gold Fact_OrderLine'[amount_received] )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: 5bd3f542-8387-417e-8cf2-37c4d2858a3b

	measure 'Gross Revenue' = SUM ( 'gold Fact_OrderLine'[revenue] )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: 363e43e8-aeb2-46b4-a320-afe7fe6aba81

	measure 'Discount Amount' = SUM ( 'gold Fact_OrderLine'[discount_amount] )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: 96071680-69cf-440e-b6d4-a51c1d230842

	measure 'Units Sold' = SUM ( 'gold Fact_OrderLine'[quantity] )
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 1d7defcf-6039-473f-b055-08800d269143

	measure 'Gross Revenue Lost' = CALCULATE ( [Gross Revenue], 'gold Dim_Order'[order_status] = "Hủy" )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: 89102dcb-7f79-417d-b8e2-d7e47a78727b

	measure Orders = DISTINCTCOUNT ( 'gold Dim_Order'[order_id] )
		formatString: #,0
		displayFolder: Orders
		lineageTag: be0f24df-613b-4d4c-a41b-1fc873f742dc

	measure 'Cancelled Orders' = CALCULATE ( [Orders], 'gold Dim_Order'[order_status] = "Hủy" )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 7b84e751-a698-4015-bdb3-f2d2bae2aca5

	measure 'Completed Orders' = CALCULATE ( [Orders], 'gold Dim_Order'[order_status] = "Không hủy" )
		formatString: #,0
		displayFolder: Orders
		lineageTag: b5f73484-83aa-4f89-aca2-ec3a1cfc98a3

	measure 'Cancel Rate' = DIVIDE ( [Cancelled Orders], [Orders] )
		formatString: 0.0%
		displayFolder: Orders
		lineageTag: 856ffbee-de0e-4a4c-9b8a-f475f7a20453

	measure AOV = DIVIDE ( [Net Revenue], [Completed Orders] )
		formatString: \₫#,0
		displayFolder: Basket & AOV
		lineageTag: b7071b7b-78e7-4a8d-a332-70e5a73dfb18

	measure 'Basket Size' = CALCULATE ( AVERAGEX ( VALUES ( 'gold Dim_Order'[order_id] ), CALCULATE ( DISTINCTCOUNT ( 'gold Fact_OrderLine'[product_id] ) ) ), 'gold Dim_Order'[order_status] = "Không hủy" )
		formatString: 0.00
		displayFolder: Basket & AOV
		lineageTag: 40012e4f-894d-42bf-bdba-fac0c73e9c63

	measure 'Single-item Order %' = VAR Base = CALCULATETABLE ( VALUES ( 'gold Dim_Order'[order_id] ), 'gold Dim_Order'[order_status] = "Không hủy" ) VAR SingleItem = FILTER ( Base, CALCULATE ( DISTINCTCOUNT ( 'gold Fact_OrderLine'[product_id] ) ) = 1 ) RETURN DIVIDE ( COUNTROWS ( SingleItem ), COUNTROWS ( Base ) )
		formatString: 0.0%
		displayFolder: Basket & AOV
		lineageTag: 67dc66c9-e6a6-45a8-bb70-c4698ccf02d6

	measure 'AOV (Gift)' = CALCULATE ( [AOV], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: \₫#,0
		displayFolder: Basket & AOV
		lineageTag: 467b3759-40b0-4bf4-87ca-b24dfff7bea6

	measure 'AOV (No Gift)' = CALCULATE ( [AOV], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: \₫#,0
		displayFolder: Basket & AOV
		lineageTag: 9fbff281-753f-450c-a019-63685a6497a5

	measure Customers = DISTINCTCOUNT ( 'gold Dim_Order'[customer_id] )
		formatString: #,0
		displayFolder: Customer
		lineageTag: 32522a7d-6bf4-417a-a61b-70fbe8cdff1c

	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( 'gold Dim_Customer'[customer_id] ), CALCULATE ( DISTINCTCOUNT ( 'gold Dim_Order'[order_id] ) ) >= 2 ) )
		formatString: #,0
		displayFolder: Customer
		lineageTag: dff3b5b0-ee69-438b-8222-fb0ab5d035e5

	measure 'Repeat Customer Rate' = DIVIDE ( [Repeat Customers], [Customers] )
		formatString: 0.0%
		displayFolder: Customer
		lineageTag: 3afa4ef0-9dfb-4d41-bb0d-14db805a0ec5

	measure 'Net Revenue PM' = CALCULATE ( [Net Revenue], DATEADD ( 'gold Dim_Date'[date], -1, MONTH ) )
		formatString: \₫#,0
		displayFolder: Time Intelligence
		lineageTag: dddf62b5-0f35-453f-9032-d16f3b563edd

	measure 'Net Revenue MoM %' = DIVIDE ( [Net Revenue] - [Net Revenue PM], [Net Revenue PM] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 00a6e314-a775-4ca7-9f97-15067e01e109

	measure 'Pair Priority Score' = VAR l = MAX ( 'gold vw_MBA_SubCategory_Pairs'[lift] ) VAR n = MAX ( 'gold vw_MBA_SubCategory_Pairs'[pair_order_count] ) RETURN IF ( n > 0, l * LN ( n ) )
		formatString: 0.00
		displayFolder: MBA
		lineageTag: 15d6a76a-9e2b-4dd9-9c65-3f47f4a715c1

	measure 'Avg Lift' = AVERAGE ( 'gold vw_MBA_SubCategory_Pairs'[lift] )
		formatString: 0.00
		displayFolder: MBA
		lineageTag: 12261cd4-0f7a-46a9-8755-1da8ccebcd69

	measure 'Max Confidence' = MAX ( 'gold vw_MBA_SubCategory_Pairs'[confidence_a_to_b] )
		formatString: 0.0%
		displayFolder: MBA
		lineageTag: 6e5285d6-a5ba-465c-93ad-97205a16e58d

	measure 'Cross-sell Attach Rate' = VAR OrdersInCtx = CALCULATETABLE ( VALUES ( 'gold Dim_Order'[order_id] ), 'gold Dim_Order'[order_status] = "Không hủy" ) VAR Attached = FILTER ( OrdersInCtx, CALCULATE ( COUNTROWS ( SUMMARIZE ( 'gold Fact_OrderLine', 'gold Dim_Category'[sub_category_name] ) ), REMOVEFILTERS ( 'gold Dim_Category' ) ) >= 2 ) RETURN DIVIDE ( COUNTROWS ( Attached ), COUNTROWS ( OrdersInCtx ) )
		formatString: 0.0%
		displayFolder: Basket & AOV
		lineageTag: 16d0899c-1332-4f2e-8ecf-25e189b5fd8d

	measure 'Completed Orders MoM %' = VAR prev = CALCULATE ( [Completed Orders], DATEADD ( 'gold Dim_Date'[date], -1, MONTH ) ) RETURN DIVIDE ( [Completed Orders] - prev, prev )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 433307d1-b4a6-4f49-b45c-0dd7911439de

	measure 'AOV MoM %' = VAR prev = CALCULATE ( [AOV], DATEADD ( 'gold Dim_Date'[date], -1, MONTH ) ) RETURN DIVIDE ( [AOV] - prev, prev )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: af863d1b-b5e5-4771-bc09-7f4279e2db9e

	measure 'Cancel Rate MoM %' = VAR prev = CALCULATE ( [Cancel Rate], DATEADD ( 'gold Dim_Date'[date], -1, MONTH ) ) RETURN DIVIDE ( [Cancel Rate] - prev, prev )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: fb421c82-5367-43de-8a9f-aa820b94ea6b

	measure 'Net Revenue % of Category' = DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALL ( 'gold Dim_Category' ) ) )
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: 80499928-3706-4527-88ce-419f40d7e91e

	measure 'Province Rank by Revenue' = IF ( ISBLANK ( [Net Revenue] ), BLANK (), RANKX ( ALL ( 'gold Dim_Province'[province_name] ), [Net Revenue], , DESC, DENSE ) )
		formatString: 0
		isHidden
		displayFolder: Revenue
		lineageTag: 25392806-6351-4aff-873c-75f28548e45c

	measure 'Discount on Completed Orders' = CALCULATE ( [Discount Amount], 'gold Dim_Order'[order_status] = "Không hủy" )
		formatString: \₫#,0
		isHidden
		displayFolder: Revenue
		lineageTag: 8a2f1e6c-4b0d-4f2a-9c1e-7d3b5a6f2c11

	measure 'Revenue Bridge Value' = SWITCH ( SELECTEDVALUE ( '_Revenue_Bridge'[Category] ), "Gross Revenue", [Gross Revenue], "− Chiết khấu", - [Discount on Completed Orders], "− Đơn hủy", - [Gross Revenue Lost], BLANK () )
		formatString: \₫#,0
		isHidden
		displayFolder: Revenue
		lineageTag: 3d7c9f0a-2e5b-4a1d-8f6c-9b0e4d2a7c88

	measure 'Revenue Bridge Value (Tỷ)' = DIVIDE ( [Revenue Bridge Value], 1000000000 )
		formatString: \₫#,0.00" Tỷ"
		isHidden
		displayFolder: Revenue
		lineageTag: 6f1a2b3c-8d4e-4f5a-9b6c-7d8e9f0a1b2c

	measure 'Net Revenue (Tỷ)' = DIVIDE ( [Net Revenue], 1000000000 )
		formatString: \₫#,0.00" Tỷ"
		isHidden
		displayFolder: Revenue
		lineageTag: 7a2b3c4d-9e5f-4a6b-8c7d-1e2f3a4b5c6d

	measure 'Net Revenue (Triệu)' = DIVIDE ( [Net Revenue], 1000000 )
		formatString: \₫#,0" Triệu"
		isHidden
		displayFolder: Revenue
		lineageTag: 2e4f6a8c-0b1d-4e3f-a5c7-9d0e1f2a3b4c

	measure 'Gross Revenue Lost (Triệu)' = DIVIDE ( [Gross Revenue Lost], 1000000 )
		formatString: \₫#,0" Triệu"
		isHidden
		displayFolder: Revenue
		lineageTag: 9d0e1f2a-3b4c-4d5e-8f6a-1b2c3d4e5f6a

	measure 'AOV (Nghìn)' = DIVIDE ( [AOV], 1000 )
		formatString: \₫#,0" Nghìn"
		isHidden
		displayFolder: Basket & AOV
		lineageTag: 5c6d7e8f-1a2b-4c3d-9e0f-4a5b6c7d8e9f

	measure 'Order Line Count' = IF ( NOT ISBLANK ( [Gross Revenue] ), CALCULATE ( COUNTROWS ( 'gold Fact_OrderLine' ), ALLEXCEPT ( 'gold Dim_Order', 'gold Dim_Order'[order_id], 'gold Dim_Order'[order_status] ) ) )
		formatString: #,0
		displayFolder: Orders
		lineageTag: a6f9fb06-5d0a-48a4-ae93-08c5524db093

	measure 'Gift Count' = COUNTROWS ( 'gold Fact_Gift' )
		formatString: #,0
		displayFolder: Gift
		lineageTag: a8a0ef08-9667-4d88-8096-f44270180392

	measure 'Orders with Gift' = DISTINCTCOUNT ( 'gold Fact_Gift'[order_id] )
		formatString: #,0
		displayFolder: Gift
		lineageTag: 31989117-a70c-4838-a9b1-6b37b75f08af

	measure '% Share of Gift Orders' = DIVIDE ( [Orders with Gift], CALCULATE ( [Completed Orders], 'gold Dim_Order'[has_gift] = "Có quà" ) )
		formatString: 0.0%
		displayFolder: Gift
		lineageTag: 760c843e-5d20-48ad-8efe-eba5c06192af

	measure 'AOV (by Gift)' = CALCULATE ( [AOV], CROSSFILTER ( 'gold Fact_Gift'[order_id], 'gold Dim_Order'[order_id], Both ) )
		formatString: \₫#,0
		displayFolder: Gift
		lineageTag: 1d5121be-cd47-484f-b83a-1c5d8979e82b

	measure 'Completed Orders (Gift)' = CALCULATE ( [Completed Orders], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: #,0
		displayFolder: Orders
		lineageTag: ab335934-aff8-4401-9a70-af71a66d7451

	measure 'Completed Orders (No Gift)' = CALCULATE ( [Completed Orders], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: #,0
		displayFolder: Orders
		lineageTag: df5dc383-8a93-439c-9843-fd558c51addc

	measure 'Basket Size (Gift)' = CALCULATE ( [Basket Size], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: 0.00
		displayFolder: Basket & AOV
		lineageTag: d35685b6-9aa9-4647-963c-1890b2f0fb70

	measure 'Basket Size (No Gift)' = CALCULATE ( [Basket Size], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: 0.00
		displayFolder: Basket & AOV
		lineageTag: f3b74ae6-9a0e-4542-8c95-da387ef66974

	measure 'Net Revenue (Gift)' = CALCULATE ( [Net Revenue], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: b8a835e0-adb4-48a0-b0c7-d98899c92fa6

	measure 'Net Revenue (No Gift)' = CALCULATE ( [Net Revenue], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: \₫#,0
		displayFolder: Revenue
		lineageTag: 60a49d14-fbf8-4add-991e-93be06880a02

	measure 'Single-item Order % (Gift)' = CALCULATE ( [Single-item Order %], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: 0.0%
		displayFolder: Basket & AOV
		lineageTag: ce26229f-18b4-41cf-a35a-017f3b28908c

	measure 'Single-item Order % (No Gift)' = CALCULATE ( [Single-item Order %], FILTER ( VALUES ( 'gold Dim_Order'[order_id] ), ISBLANK ( CALCULATE ( COUNTROWS ( 'gold Fact_Gift' ) ) ) ) )
		formatString: 0.0%
		displayFolder: Basket & AOV
		lineageTag: 28d18bd1-e47a-4407-90f9-2b343eca1c95

	measure 'Pair Priority Score (Product)' = VAR l = MAX ( 'gold vw_MBA_Product_Pairs'[lift] ) VAR n = MAX ( 'gold vw_MBA_Product_Pairs'[pair_order_count] ) RETURN IF ( n > 0, l * LN ( n ) )
		formatString: 0.00
		displayFolder: MBA
		lineageTag: b817181f-801e-4cc0-984a-669995616126

	column _
		isHidden
		lineageTag: 13cdafb7-73d8-450f-bab4-2eda363d78b5
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW("_", BLANK())

